{
  "version_file": "VERSION",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "go vet ./...",
    "go test -race ./...",
    "python3 -m unittest discover -s .github/release-tests",
    "python3 scripts/check_deployment.py"
  ],
  "notes": [
    "Release binaries cover Linux amd64/arm64/ARMv7, macOS amd64/arm64, and Windows amd64/arm64. Native execution and cross-compilation are reported separately.",
    "Queues are ephemeral and single-replica. Command acknowledgement suppresses retry duplicates within a player session; it is not durable exactly-once delivery.",
    "OCI archives are published without rebuilding. Physical player and live cluster acceptance are separate checks."
  ],
  "container_assets": {
    "ottplay-control-server-container.oci.tar": "ghcr.io/open-ott-play/ottplay-control-server"
  },
  "repository": "open-ott-play/ottplay-control-server",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "VERSION",
        "format": "text",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "ottplay-control-server-*.version.json",
        "format": "json",
        "value": "package",
        "field": "version"
      },
      {
        "path": "ottplay-control-server-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
        ],
        "value": "package"
      }
    ],
    "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd",
    "required_build_receipts": [
      "release-inputs-container.json",
      "release-inputs-darwin-amd64.json",
      "release-inputs-darwin-arm64.json",
      "release-inputs-deployment.json",
      "release-inputs-linux-amd64.json",
      "release-inputs-linux-arm64.json",
      "release-inputs-linux-armv7.json",
      "release-inputs-windows-amd64.json",
      "release-inputs-windows-arm64.json"
    ]
  },
  "change_scope": {
    "documentation_paths": ["GOVERNANCE.md", "README.ar.md", "README.bn.md", "README.cs.md", "README.de.md", "README.es.md", "README.fa.md", "README.fr.md", "README.he.md", "README.hi.md", "README.id.md", "README.it.md", "README.ja.md", "README.ko.md", "README.nl.md", "README.pl.md", "README.pt.md", "README.ru.md", "README.th.md", "README.tr.md", "README.uk.md", "README.vi.md", "README.zh-Hans.md", "README.zh-Hant.md", "ROADMAP.md"],
    "required_paths": [
      "CHANGELOG.md"
    ],
    "always_validate_workflows": ["dependency-review.yml"]
  },
  "nightly_cron": "52 5 * * *",
  "release_notes": "CHANGELOG.md",
  "fuzzing": {
    "toolkit_ref": "0047a13b5eb79dfa770e31070a83e9696ddd36d1"
  },
  "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd",
  "single_entry_ci": true
}
