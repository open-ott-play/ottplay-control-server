[Unit]
Description=OTT Android USB manager lifecycle
After=pkgctl-ContainerManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/etc/android-manager/manager.py --config /usr/local/etc/android-manager/config.json host
Restart=always
RestartSec=10
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
