              "type": "null"
            }
          ]
        },
        "page_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "rows": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/resolution_row"
          }
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "type": "null"
