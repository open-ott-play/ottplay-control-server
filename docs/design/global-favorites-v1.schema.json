        "outcome",
        "receipt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "op": {
          "const": "status"
        },
        "subject": {
          "const": "global"
        },
        "operation_id": {
